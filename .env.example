APP_NAME=Nexus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# En producción: https://nexus.cdjuarez.tecnm.mx (los QR de la credencial y los enlaces de correo salen de aquí)
APP_URL=http://localhost

OCTANE_SERVER=frankenphp

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nexus
DB_USERNAME=nexus
DB_PASSWORD=secret

# Contraseña inicial del usuario `admin` que crea `db:seed`; se cambia en el primer acceso.
# Obligatoria fuera de local y testing. Vacía en local, el seeder genera una aleatoria y la muestra.
ADMIN_INITIAL_PASSWORD=

# Contraseña por defecto de las altas manuales, de «Dar acceso», de los reinicios de contraseña y de la invitación
# de acceso (va en su correo). Quien entra con ella debe cambiarla. Defínela solo aquí: el repositorio es público.
NEXUS_DEFAULT_PASSWORD=

# Dominio del correo institucional de los docentes, al que va su invitación de acceso (AC-06).
NEXUS_INSTITUTIONAL_EMAIL_DOMAIN=cdjuarez.tecnm.mx

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=secret
REDIS_PORT=6379

# Desarrollo y demo: Mailpit atrapa todo el correo (ADR-0024); su bandeja, en http://127.0.0.1:8025.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Producción manda por Microsoft 365 con Microsoft Graph y permisos delegados (ADR-0032; guía en
# docs/operacion/despliegue.md, «Correo saliente (Microsoft 365)»). Para probarlo aquí, descomenta y
# llena con una app de Azure cuya Redirect URI sea APP_URL + /configuracion/correo/microsoft/callback,
# y conecta la cuenta en Configuración → Correos y colas. Ojo: así sí salen correos reales.
# MAIL_MAILER=microsoft-graph
# MICROSOFT_GRAPH_TENANT_ID=
# MICROSOFT_GRAPH_CLIENT_ID=
# MICROSOFT_GRAPH_CLIENT_SECRET=

# Motor de horarios (servicio Python, fase 7). SOLVER_URL es el nombre del servicio en la red interna de compose;
# SOLVER_TOKEN lo comparten `queue` y el servicio (en dev, sin definirlo, el servicio usa `dev-solver-token`: pon
# aquí el mismo valor para que `queue` lo alcance). Con los dos definidos, el motor «CP-SAT (servicio)» se ofrece al
# lanzar una corrida; sin token no aparece. Ver services/solver/README.md.
SOLVER_URL=http://solver:8000
SOLVER_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Fotos de los alumnos para la credencial (AC-20): <AAAA>/<número de control>.jpg. Vacío = storage/app/fotos.
# En el servidor, compose.prod.yaml monta NEXUS_STUDENT_PHOTOS_DIR (por omisión /srv/nexus/fotos) en esa ruta.
STUDENT_PHOTOS_PATH=
# Dirección pública para el enlace del QR de la credencial (AC-20). Vacía = APP_URL. Solo para una demo detrás de un túnel.
NEXUS_CREDENTIAL_URL=

# Token del detalle de /health (cabecera X-Health-Token). Genera con: openssl rand -hex 24
HEALTH_TOKEN=
