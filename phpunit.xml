<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <!-- Livewire compila Blade y los componentes MFC a storage/: sobre el archivo fuente la cobertura
             siempre da cero. Los cubren las pruebas feature y browser. Migraciones y factories corren en
             toda prueba y no son lógica del módulo: inflarían su mínimo (docs/arquitectura/testing.md). -->
        <exclude>
            <directory suffix=".blade.php">app</directory>
            <directory>app/Modules/*/Livewire</directory>
            <directory>app/Modules/*/Database/Migrations</directory>
            <directory>app/Modules/*/Database/Factories</directory>
        </exclude>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_LOCALE" value="es"/>
        <env name="APP_FAKER_LOCALE" value="es_MX"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Sin force="true": se puede sobreescribir con `docker compose exec -e DB_DATABASE=...` (worktrees en paralelo) -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="nexus_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
