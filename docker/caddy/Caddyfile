# Proxy inverso con HTTPS automático (ADR-0013). Caddy obtiene y renueva solo el
# certificado de Let's Encrypt para APP_DOMAIN; los certificados viven en el
# volumen caddy-data. Las variables llegan desde compose.prod.yaml.
{
	email {$ACME_EMAIL}

	# Vacío en producción. Solo para pruebas (ver docs/operacion/despliegue.md):
	#   local_certs  -> CA interna de Caddy, sin salir a internet
	#   acme_ca https://acme-staging-v02.api.letsencrypt.org/directory  -> staging de Let's Encrypt
	{$CADDY_GLOBAL_OPTIONS}
}

{$APP_DOMAIN} {
	encode zstd gzip

	# Opt-in: contraseña previa al sitio para mostrarlo por un túnel (ver
	# docs/operacion/despliegue.md, «Mostrar la prueba de concepto»). Sin
	# BASIC_AUTH_USER el matcher es falso y no se pide nada. Caddy aprovisiona
	# basic_auth aunque el matcher no coincida, así que el respaldo del hash debe
	# ser base64 válido: «b2Zm» es «off» en base64; con «off» Caddy no arranca.
	# /health queda fuera: lo usa el deployer para verificar cada despliegue.
	@gate {
		expression `"{$BASIC_AUTH_USER:}" != ""`
		not path /health
	}
	basic_auth @gate {
		{$BASIC_AUTH_USER:off} {$BASIC_AUTH_HASH:b2Zm}
	}

	request_body {
		max_size 20MB
	}

	header {
		Strict-Transport-Security "max-age=15552000"
		-Server
	}

	# Assets compilados (Vite): los sirve Caddy desde el volumen build-assets, donde el deployer deja los de
	# los últimos releases. Una página que sirvió la versión vieja sigue encontrando sus archivos después del
	# cambio de color. Los nombres llevan hash, así que se pueden guardar para siempre en el navegador.
	handle /build/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Cero caídas (ADR-0033): los dos colores de la app, y `first` manda todo al primero que esté sano; nunca
	# reparte entre versiones. Caddy pregunta /health cada 2 s: un color que no existe, que está arrancando o
	# que el deployer drenó (su /health responde 503) sale de la rotación en un intervalo y todo pasa al otro.
	# Si una conexión falla (el contenedor se acaba de detener), reintenta en el otro color hasta 15 s.
	handle {
		reverse_proxy app-blue:8000 app-green:8000 {
			lb_policy first
			lb_try_duration 15s
			lb_try_interval 250ms
			fail_duration 5s
			health_uri /health
			health_interval 2s
			health_timeout 2s
			health_status 200
			# Solo a esta sonda le responde /health «draining» (503) un color que se está apagando; al público le
			# sigue respondiendo normal hasta que Caddy lo saca de la rotación.
			health_headers {
				X-Health-Probe lb
			}
		}
	}

	# Sin ningún color sano (la restauración de un respaldo, o el primer arranque) Caddy responde por su cuenta.
	handle_errors 502 503 504 {
		header Content-Type "text/html; charset=utf-8"
		respond "<!doctype html><meta charset=utf-8><title>Nexus</title><p>Nexus está en mantenimiento. Vuelve a intentarlo en unos minutos.</p>" 503
	}

	# El registro de peticiones no guarda el parámetro `token` de la consulta: el enlace para restablecer la
	# contraseña lo lleva (`/reset-password?token=…`, AC-17) y sirve 60 minutos.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
				}
			}
		}
	}
}
