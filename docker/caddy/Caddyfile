# Proxy inverso con HTTPS automático (ADR-0013). Caddy obtiene y renueva solo el
# certificado de Let's Encrypt para APP_DOMAIN; los certificados viven en el
# volumen caddy-data. Las variables llegan desde compose.prod.yaml.
{
	email {$ACME_EMAIL}

	# Vacío en producción. Solo para pruebas (ver docs/operacion/despliegue.md):
	#   local_certs  -> CA interna de Caddy, sin salir a internet
	#   acme_ca https://acme-staging-v02.api.letsencrypt.org/directory  -> staging de Let's Encrypt
	{$CADDY_GLOBAL_OPTIONS}
}

{$APP_DOMAIN} {
	encode zstd gzip

	# Opt-in: contraseña previa al sitio para mostrarlo por un túnel (ver
	# docs/operacion/despliegue.md, «Mostrar la prueba de concepto»). Sin
	# BASIC_AUTH_USER el matcher es falso y no se pide nada. Caddy aprovisiona
	# basic_auth aunque el matcher no coincida, así que el respaldo del hash debe
	# ser base64 válido: «b2Zm» es «off» en base64; con «off» Caddy no arranca.
	@gate expression `"{$BASIC_AUTH_USER:}" != ""`
	basic_auth @gate {
		{$BASIC_AUTH_USER:off} {$BASIC_AUTH_HASH:b2Zm}
	}

	request_body {
		max_size 20MB
	}

	header {
		Strict-Transport-Security "max-age=15552000"
		-Server
	}

	# Caddy resuelve `app` en cada conexión nueva, así que un contenedor recreado
	# (nuevo despliegue) se alcanza sin recargar. Si app aún no responde, espera
	# unos segundos en lugar de devolver 502 al primer intento.
	reverse_proxy app:8000 {
		lb_try_duration 15s
		lb_try_interval 500ms
	}

	log {
		output stdout
	}
}
