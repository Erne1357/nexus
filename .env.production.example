# Plantilla del .env de PRODUCCIÓN (ADR-0013). En el servidor:
#   cp .env.production.example .env && chmod 600 .env
# y reemplaza todo lo que diga CAMBIAR. Este archivo no lleva secretos reales;
# el .env del servidor NUNCA se sube a git.
#
# Compose también lee este archivo para interpolar valores (${VAR}): no uses `$`
# ni espacios en las contraseñas. Genera cada una con `openssl rand -hex 24`.

# --- Servidor ---------------------------------------------------------------
# Hace que `docker compose` use siempre el stack de producción, sin escribir -f.
COMPOSE_FILE=compose.yaml:compose.prod.yaml

# Nombre público (sin https://) y correo para los avisos de vencimiento de Let's Encrypt.
# APP_URL se deriva de APP_DOMAIN en compose.prod.yaml; no se define aquí.
APP_DOMAIN=nexus.example.edu.mx
ACME_EMAIL=ti@example.edu.mx

# Versión a desplegar: el tag de git (p. ej. v1.0.0) con el que se construye la imagen.
APP_IMAGE_TAG=latest

# --- Aplicación -------------------------------------------------------------
# compose.prod.yaml fuerza APP_ENV=production, APP_DEBUG=false y cookies seguras.
APP_NAME=Nexus
APP_ENV=production
APP_DEBUG=false
# Genera con: echo "base64:$(openssl rand -base64 32)"
# Si cambia, se cierran todas las sesiones; guarda una copia fuera del servidor.
APP_KEY=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# --- PostgreSQL -------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nexus
DB_USERNAME=nexus
DB_PASSWORD=CAMBIAR

# --- Valkey (caché, sesiones y colas) ---------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Sin correo saliente en R1 (las contraseñas iniciales se entregan en persona).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nexus@example.edu.mx"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Respaldos (servicio backup) --------------------------------------------
# Directorio del servidor donde caen los pg_dump. Créalo antes: sudo install -d -m 700 /var/backups/nexus
BACKUP_DIR=/var/backups/nexus
# Hora local (America/Ciudad_Juarez) del respaldo diario y retención.
BACKUP_TIME=03:00
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# Dueño de los archivos de respaldo (id -u / id -g del usuario que los copiará). 0 = root.
BACKUP_UID=0
BACKUP_GID=0

# --- Puertos y pruebas (déjalos así en producción) --------------------------
# HTTP_PORT=80
# HTTPS_PORT=443
# CADDY_GLOBAL_OPTIONS=
# APP_START_PERIOD=120s
