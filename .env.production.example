# Plantilla del .env de PRODUCCIÓN (ADR-0013). En el servidor:
#   cp .env.production.example .env && chmod 600 .env
# y reemplaza todo lo que diga CAMBIAR. Este archivo no lleva secretos reales;
# el .env del servidor NUNCA se sube a git.
#
# Compose también lee este archivo para interpolar valores (${VAR}): no uses `$`
# ni espacios en las contraseñas. Genera cada una con `openssl rand -hex 24`.

# --- Servidor ---------------------------------------------------------------
# Hace que `docker compose` use siempre el stack de producción, sin escribir -f.
COMPOSE_FILE=compose.yaml:compose.prod.yaml

# Nombre público (sin https://) y correo para los avisos de vencimiento de Let's Encrypt.
# APP_URL se deriva de APP_DOMAIN en compose.prod.yaml; no se define aquí.
APP_DOMAIN=nexus.example.edu.mx
ACME_EMAIL=ti@example.edu.mx

# La versión desplegada no va aquí: la decide el deployer con cada release (ADR-0033).

# --- Aplicación -------------------------------------------------------------
# compose.prod.yaml fuerza APP_ENV=production, APP_DEBUG=false y cookies seguras.
APP_NAME=Nexus
APP_ENV=production
APP_DEBUG=false
# Genera con: echo "base64:$(openssl rand -base64 32)"
# Si cambia, se cierran todas las sesiones; guarda una copia fuera del servidor.
APP_KEY=

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
# Contraseña inicial del usuario `admin` (la usa `php artisan db:seed --force` una sola vez;
# el sistema obliga a cambiarla en el primer acceso). `openssl rand -hex 12`
ADMIN_INITIAL_PASSWORD=CAMBIAR

LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# --- PostgreSQL -------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nexus
DB_USERNAME=nexus
DB_PASSWORD=CAMBIAR

# --- Valkey (caché, sesiones y colas) ---------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=CAMBIAR

# --- Motor de horarios (servicio Python, fase 7) -----------------------------
# Token compartido entre `queue` y el servicio `solver` (openssl rand -hex 32). Obligatorio: sin él el stack no levanta.
SOLVER_URL=http://solver:8000
SOLVER_TOKEN=CAMBIAR

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Correo saliente: Microsoft 365 por Microsoft Graph, permisos delegados (ADR-0032) ---
# Pasos de Azure y de Nexus: docs/operacion/despliegue.md, «Correo saliente (Microsoft 365)».
# El correo sale como la cuenta que el admin conecta en Configuración → Correos y colas
# («Conectar con Microsoft»); pon esa misma cuenta en MAIL_FROM_ADDRESS (p. ej. un buzón
# institucional). El nombre que ve quien recibe es el del buzón en Microsoft 365, no MAIL_FROM_NAME.
MAIL_MAILER=microsoft-graph
MAIL_FROM_ADDRESS="CAMBIAR@cdjuarez.tecnm.mx"
MAIL_FROM_NAME="${APP_NAME}"
# Azure portal → Microsoft Entra ID → App registrations → la app de Nexus → Overview:
# «Directory (tenant) ID» y «Application (client) ID».
MICROSOFT_GRAPH_TENANT_ID=CAMBIAR
MICROSOFT_GRAPH_CLIENT_ID=CAMBIAR
# Certificates & secrets → New client secret: copia el «Value» (no el «Secret ID»). Vence:
# anota la fecha y, antes, crea otro y ponlo aquí (docker compose up -d).
MICROSOFT_GRAPH_CLIENT_SECRET=CAMBIAR

VITE_APP_NAME="${APP_NAME}"

# --- Respaldos (servicio backup) --------------------------------------------
# Directorio del servidor donde caen los pg_dump. Créalo antes: sudo install -d -m 700 /var/backups/nexus
BACKUP_DIR=/var/backups/nexus
# Hora local (America/Ciudad_Juarez) del respaldo diario y retención.
BACKUP_TIME=03:00
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# Dueño de los archivos de respaldo (id -u / id -g del usuario que los copiará). 0 = root.
BACKUP_UID=0
BACKUP_GID=0

# --- Puertos y pruebas (déjalos así en producción) --------------------------
# HTTP_PORT=80
# HTTPS_PORT=443
# CADDY_GLOBAL_OPTIONS=
# Contraseña previa al sitio, solo para mostrarlo por un túnel (runbook, «Mostrar la prueba de
# concepto»). Déjalas comentadas en producción. El hash va entre comillas simples (lleva `$`).
# BASIC_AUTH_USER=demo
# BASIC_AUTH_HASH='$2a$14$...'
# APP_START_PERIOD=120s

# --- Salud ------------------------------------------------------------------
# Token del detalle de /health (cabecera X-Health-Token); sin él solo salen los estados.
# Genera con: openssl rand -hex 24
HEALTH_TOKEN=CAMBIAR

# --- Despliegue continuo (ADR-0033) -------------------------------------------
# Carpeta del servidor con los releases, el estado del deployer y la carpeta de entrada. El servicio
# `deployer` la monta en la misma ruta; créala antes: sudo install -d -o "$USER" /opt/nexus
NEXUS_HOME=/opt/nexus
# bundle: el servidor sin internet despliega los paquetes (nexus-<sha>.tar y su .sha256) que se copian a
# DEPLOY_INBOX. github: con salida a internet, toma los despliegues de GitHub.
DEPLOY_SOURCE=bundle
DEPLOY_INBOX=/opt/nexus/inbox
# Con DEPLOY_SOURCE=github, el token NO va aquí (este archivo lo leen también la app y la cola): va en
# /opt/nexus/deployer.env (chmod 600) como DEPLOY_GITHUB_TOKEN=…, un token fine-grained del repositorio con permiso de
# lectura y escritura solo en «Deployments».
DEPLOY_REPOSITORY=Erne1357/nexus
DEPLOY_POLL_SECONDS=60
# Releases (con sus imágenes) que se conservan para volver atrás sin internet.
DEPLOY_KEEP_RELEASES=5
# Segundos que se espera a que la versión nueva responda /health antes de darla por fallida.
DEPLOY_HEALTH_TIMEOUT=180
# Una migración que no consigue su candado en este tiempo falla, y el despliegue se aborta sin bloquear a la
# versión que sigue atendiendo.
MIGRATE_LOCK_TIMEOUT=10s
# Respaldos previos a las migraciones que se conservan (BACKUP_DIR/predeploy).
BACKUP_KEEP_PREDEPLOY=5
# Workers de Octane por color (auto = uno por núcleo). Durante un cambio de color corren dos instancias.
OCTANE_WORKERS=auto
